# Required: private key of the account used to send transactions
PRIVATE_KEY=0x

# Required: deployed Storage4Manager contract address
# Testnet
STORAGE4MANAGER=0x16afec03c504a8b237c7afa2c08c20f82d602e5f
# Mainnet
#STORAGE4MANAGER=0x274A67578fFdbbCa5c600a694fe59F57Fb8A043a

# Optional: RPC endpoint to use.
# If not set, defaults based on USE_MAINNET below.
RPC=

# Optional: set to 1 to use Immutable mainnet (https://rpc.immutable.com)
# when RPC is not set. Defaults to 0 (testnet: https://rpc.testnet.immutable.com).
USE_MAINNET=0
